-            && crossing.vxMetersPerSecond() > 0.0
-            && centerOffset <= usableHalfSpan
-            && nearRimClearance >= ShotModelConstants.HUB_RIM_MARGIN_METERS
-            && entryAngle >= ShotModelConstants.MIN_ENTRY_ANGLE_DEGREES;
