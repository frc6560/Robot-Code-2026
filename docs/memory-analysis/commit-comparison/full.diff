-    private final Map<Long, Solution> solutionCache = new LinkedHashMap<>(32, 0.75f, true) {
-        @Override
-        protected boolean removeEldestEntry(Map.Entry<Long, Solution> eldest) {
-            return size() > MAX_CACHE_ENTRIES;
-        }
