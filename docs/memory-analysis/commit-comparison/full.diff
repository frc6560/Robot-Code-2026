+/** Fixed launch-speed scale. Dashboard and legacy saved preferences never select this value. */
+public final class LaunchSpeedTuning {
+    public static final double DEFAULT_COEFFICIENT = 1.025;
+    /** Legacy dashboard key, now published for display only. */
+    public static final String REQUEST_KEY = "Shooter/Launch Speed Coefficient";
+    /** Legacy preference key, retained for compatibility; never read or written. */
+    public static final String PREFERENCE_KEY = "ShooterLaunchSpeedCoefficientV2";
+    private static double nextTelemetry;
+    private LaunchSpeedTuning() {}
+
+    public static void initialize() {
+        SmartDashboard.getEntry(REQUEST_KEY).clearPersistent();
+        publish();
+    }
+
+    /** The same fixed scale applies before shooting, while disabled, and during every shot. */
+    public static double update() {
+        double now = edu.wpi.first.wpilibj.Timer.getFPGATimestamp();
+        if (now >= nextTelemetry) {
+            nextTelemetry = now + 0.5;
+            publish();
+        }
+        return DEFAULT_COEFFICIENT;
+    }
+
+    private static void publish() {
+        RateLimitedTelemetry.putNumber(REQUEST_KEY, DEFAULT_COEFFICIENT);
+        RateLimitedTelemetry.putString("Shooter/Launch Speed Coefficient Status",
+            "Fixed in code: 1.025; dashboard edits ignored");
+        RateLimitedTelemetry.recordOutput("Fuel/Tuning/AppliedCoefficient", DEFAULT_COEFFICIENT);
+    }
+}
diff --git a/src/main/java/frc/robot/utility/shooting/PrecomputedShots.java b/src/main/java/frc/robot/utility/shooting/PrecomputedShots.java
new file mode 100644
index 0000000..02a339e
--- /dev/null
+++ b/src/main/java/frc/robot/utility/shooting/PrecomputedShots.java
@@ -0,0 +1,73 @@
+package frc.robot.utility.shooting;
+
+import edu.wpi.first.wpilibj.Filesystem;
+import frc.robot.Constants.ShotModelConstants;
+import frc.robot.utility.shooting.FuelShotModel.Flight;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Arrays;
+import java.lang.reflect.Modifier;
+
+/** Offline-generated 5 RPM grid; the 10 RPM solver's band midpoints also lie on this grid. */
+public final class PrecomputedShots {
+    private PrecomputedShots() {}
+
+    static String signature() {
+        StringBuilder result = new StringBuilder("rk4-v1");
+        for (Class<?> type : new Class<?>[] {ShotModelConstants.class, FuelShotConfig.class, LaunchSpeedTuning.class}) {
+            Arrays.stream(type.getDeclaredFields()).filter(f -> Modifier.isStatic(f.getModifiers())
+                && Modifier.isFinal(f.getModifiers()) && f.getType() == double.class)
+                .sorted(java.util.Comparator.comparing(java.lang.reflect.Field::getName)).forEach(f -> {
+                    try { result.append('|').append(f.getName()).append('=').append(f.getDouble(null)); }
+                    catch (IllegalAccessException e) { throw new IllegalStateException(e); }
+                });
+        }
+        var calibration = LaunchCalibration.ideal();
+        result.append('|').append(calibration.minRPM()).append('|').append(calibration.maxRPM());
+        return result.toString();
+    }
+
+    public static FuelShotModel load() {
+        return load(Filesystem.getDeployDirectory().toPath().resolve("shooting/trajectories.csv"));
+    }
+
+    public static FuelShotModel load(Path path) {
+        try (var reader = Files.newBufferedReader(path)) {
+            if (!signature().equals(reader.readLine()))
+                throw new IllegalStateException("Shot table is stale; run generateShotTable before deployment");
+            var calibration = LaunchCalibration.ideal();
+            int count = (int) ((calibration.maxRPM() - calibration.minRPM()) / 5) + 1;
+            Flight[] flights = new Flight[count];
+            for (int i = 0; i < count; i++) {
+                String line = reader.readLine();
+                if (line == null) throw new IllegalArgumentException("Truncated shot table");
+                String[] cells = line.split(",");
+                if (cells.length != 6 || Double.parseDouble(cells[0]) != calibration.minRPM() + i * 5)
+                    throw new IllegalArgumentException("Invalid shot grid");
+                flights[i] = new Flight(Double.parseDouble(cells[1]), Double.parseDouble(cells[2]),
+                    Double.parseDouble(cells[3]), Double.parseDouble(cells[4]), Boolean.parseBoolean(cells[5]));
+            }
+            if (reader.readLine() != null) throw new IllegalArgumentException("Extra shot rows");
+            return new FuelShotModel(calibration, flights);
+        } catch (java.io.IOException e) {
+            throw new IllegalStateException("Cannot load precomputed shot table", e);
+        }
+    }
+
+    /** Desktop only: invoke with Gradle generateShotTable after changing physics constants. */
+    public static void main(String[] args) throws Exception {
+        Path path = Path.of("src/main/deploy/shooting/trajectories.csv");
+        Files.createDirectories(path.getParent());
+        var model = new FuelShotModel(LaunchCalibration.ideal());
+        try (var writer = Files.newBufferedWriter(path)) {
+            writer.write(signature());
+            writer.newLine();
+            for (double rpm = model.calibration().minRPM(); rpm <= model.calibration().maxRPM(); rpm += 5) {
+                Flight f = model.flight(rpm);
+                writer.write(rpm + "," + f.crossingX() + "," + f.entryDegrees() + "," + f.time()
+                    + "," + f.risingX() + "," + f.reached());
+                writer.newLine();
+            }
+        }
+    }
+}
diff --git a/src/main/java/frc/robot/utility/telemetry/LatestValueLimiter.java b/src/main/java/frc/robot/utility/telemetry/LatestValueLimiter.java
new file mode 100644
index 0000000..e2aa529
--- /dev/null
+++ b/src/main/java/frc/robot/utility/telemetry/LatestValueLimiter.java
@@ -0,0 +1,79 @@
+package frc.robot.utility.telemetry;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.function.BiConsumer;
+import java.util.function.LongSupplier;
+
+/** Bounded storage, no history queue: a suppressed update replaces the pending value. */
+final class LatestValueLimiter {
+    static final int MAX_KEYS = 2048;
+    private final Map<String, Pending> values = new LinkedHashMap<>();
+    private final Pending[] slots = new Pending[MAX_KEYS];
+    private int size;
+    private final LongSupplier clock;
+    private final BiConsumer<String, Object> writer;
+    private final java.util.function.ObjDoubleConsumer<String> doubleWriter;
+    private static final class Pending {
+        String key;
+        Object value;
+        double number;
+        boolean numeric;
+        boolean dirty;
+        long nextWrite = Long.MIN_VALUE;
+    }
+    LatestValueLimiter(LongSupplier clock, BiConsumer<String, Object> writer) {
+        this(clock, writer, (key, value) -> writer.accept(key, value));
+    }
+    LatestValueLimiter(LongSupplier clock, BiConsumer<String, Object> writer,
+            java.util.function.ObjDoubleConsumer<String> doubleWriter) {
+        this.clock = clock;
+        this.writer = writer;
+        this.doubleWriter = doubleWriter;
+    }
+    void offer(String key, Object value) {
+        Pending pending = values.get(key);
+        if (pending == null) {
+            if (values.size() >= MAX_KEYS) return;
+            pending = new Pending();
+            pending.key = key;
+            slots[size++] = pending;
+            values.put(key, pending);
+        }
+        pending.numeric = false;
+        pending.value = value;
+        pending.dirty = true;
+        writeIfDue(key, pending, clock.getAsLong());
+    }
+    void offerDouble(String key, double value) {
+        Pending pending = values.get(key);
+        if (pending == null) {
+            if (values.size() >= MAX_KEYS) return;
+            pending = new Pending();
+            pending.key = key;
+            slots[size++] = pending;
+            values.put(key, pending);
+        }
+        pending.numeric = true;
+        pending.number = value;
+        pending.value = null;
+        pending.dirty = true;
+        writeIfDue(key, pending, clock.getAsLong());
+    }
+    void flush() {
+        long now = clock.getAsLong();
+        for (int i = 0; i < size; i++) {
+            Pending pending = slots[i];
+            writeIfDue(pending.key, pending, now);
+        }
+    }
+    int keyCount() { return values.size(); }
+    private void writeIfDue(String key, Pending pending, long now) {
+        if (!pending.dirty || now < pending.nextWrite) return;
+        // Advance first so even a failing writer cannot generate a high-frequency retry storm.
+        pending.dirty = false;
+        pending.nextWrite = now + RateLimitedTelemetry.PERIOD_MICROS;
+        if (pending.numeric) doubleWriter.accept(key, pending.number);
+        else writer.accept(key, pending.value);
+    }
+}
diff --git a/src/main/java/frc/robot/utility/telemetry/RateLimitedReceiver.java b/src/main/java/frc/robot/utility/telemetry/RateLimitedReceiver.java
