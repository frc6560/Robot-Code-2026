-            distanceMeters,
-            flywheelRPM,
-            launchElevationDegrees(),
-            crossing.timeSeconds(),
-            entryAngle,
-            crossing.xMeters(),
-            usableHalfSpan - centerOffset,
-            nearRimClearance,
-            0.0,
-            0.0,
-            scoring
-        );
-    }
