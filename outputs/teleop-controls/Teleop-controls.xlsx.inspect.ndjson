{"kind":"table","sheet":"Teleop controls","address":"A1:E28","rows":28,"cols":5,"values":[[null,null,null,null,null],["Teleop controller reference",null,null,null,null],["Current working code • October 30, 2026 • includes uncommitted changes",null,null,null,null],[null,null,null,null,null],["Controller","Control","Action","How to use","Behavior / conditions"],["Xbox · USB 1","Left stick Y","Move forward / backward","Move stick","Field-oriented, alliance-relative driving; 10% deadband."],["Xbox · USB 1","Left stick X","Strafe left / right","Move stick","Field-oriented, alliance-relative driving; 10% deadband."],["Xbox · USB 1","Right stick X","Rotate robot","Move stick","10% deadband; aimed shooting takes over rotation."],["Xbox · USB 1","Right trigger (RT)","Auto aim, spin up and shoot / pass","Hold","Aim toward hub; auto pass outside own alliance zone. Feed waits for alignment, RPM and other readiness checks."],["Xbox · USB 1","Right trigger (RT)","Stop aimed shooting","Release","Stops shot command and feeding; left trigger / board 3 must also be released before manual feed can restart."],["Xbox · USB 1","Left trigger (LT)","Run floor and tunnel indexers","Hold","Manual feed; shooter stays at idle RPM. Blocked during aimed shooting and pit coast. No aimed-shot readiness gate."],["Xbox · USB 1","Left bumper (LB)","Retract intake rack","Press","Selects retracted endpoint; takes priority if both bumpers are pressed. Disabled in pit coast."],["Xbox · USB 1","Right bumper (RB)","Extend intake rack; run rollers","Press / hold","Press selects extended endpoint and requests rollers; release stops rollers, rack stays extended. LB takes priority. Disabled in pit coast."],["Xbox · USB 1","A","Align robot for trench","Press","Turns toward a trench-aligned heading (0° or 180°); finishes within 2°. Takes drivetrain control during alignment."],["Xbox · USB 1","X","Reset pose using front camera","Press","Requests a hard vision pose reset from the front Limelight; teleop only."],["Xbox · USB 1","Start / Menu","Zero heading / gyro","Press","Sets odometry heading to 0° while retaining current position."],["Xbox · USB 1","Back / View","Toggle pit coast mode","Press to toggle","Zero-output coast mode lets mechanisms move by hand; press again to restore normal control."],["Xbox · USB 1","B; Y","No assigned action","—","No binding in current code."],["Xbox · USB 1","D-pad (all directions)","No assigned action","—","No binding in current code."],["Xbox · USB 1","Left / right stick click","No assigned action","—","No binding in current code."],["Xbox · USB 1","Right stick Y","No assigned action","—","Not used by current drive bindings."],["Button board · USB 0","Button 3","Run floor and tunnel indexers","Hold","Same manual feed as LT; shooter stays at idle RPM. Both controls must release after aimed shooting to rearm."],["Button board · USB 0","Other buttons (including 5)","No active binding","—","Button 5 has a helper method, but that method is not connected to an action."],[null,null,null,null,null],["Driving while RT is held: translation is limited to 1.2 m/s; driver can still translate while automatic aim controls rotation.",null,null,null,null],["Default: shooter idles at 1,000 RPM; indexers stop unless commanded. Pit coast is cleared before teleop / autonomous starts.",null,null,null,null],[null,null,null,null,null],["Sources: RobotContainer.java; ManualControls.java; Constants.java; FuelShootCommand.java; SwerveSubsystem.java (src/main/java/frc/robot/).",null,null,null,null]]}
