package frc.robot.utility;

import java.util.HashMap;
import java.util.Map;
import org.littletonrobotics.junction.Logger;
import edu.wpi.first.wpilibj.Timer;
import com.ctre.phoenix6.hardware.TalonFX;

import frc.robot.Constants.HoodConstants;
import frc.robot.Constants.ShooterConstants;
import frc.robot.Constants.TurretConstants;
import frc.robot.Constants.IntakeConstants;
import frc.robot.Constants.FeederConstants;
import frc.robot.subsystems.shooter.Shooter;

public class DiagnosticManager {
    private final Map<String, Double> commandStartTimes = new HashMap<>();
    private final Map<String, Boolean> activeTraces = new HashMap<>();
    private final Shooter m_shooter;
    private final Map<String, TalonFX> canDevices = new HashMap<>();

    public DiagnosticManager(Shooter shooter) {
        this.m_shooter = shooter;
        
        // Hood & Turret
        canDevices.put("Node_" + HoodConstants.HOOD_MOTOR_ID + "_Hood", new TalonFX(HoodConstants.HOOD_MOTOR_ID, "rio"));
        canDevices.put("Node_" + TurretConstants.MOTOR_ID + "_Turret", new TalonFX(TurretConstants.MOTOR_ID, "rio"));
        
        // Shooter
        canDevices.put("Node_" + ShooterConstants.LEFT_FLYWHEEL_ID + "_ShooterL", new TalonFX(ShooterConstants.LEFT_FLYWHEEL_ID, "rio"));
        canDevices.put("Node_" + ShooterConstants.RIGHT_FLYWHEEL_ID + "_ShooterR", new TalonFX(ShooterConstants.RIGHT_FLYWHEEL_ID, "rio"));
        
        // Intake
        canDevices.put("Node_" + IntakeConstants.LEFT_MOTOR_ID + "_IntakeL", new TalonFX(IntakeConstants.LEFT_MOTOR_ID, IntakeConstants.CAN_BUS));
        canDevices.put("Node_" + IntakeConstants.RIGHT_MOTOR_ID + "_IntakeR", new TalonFX(IntakeConstants.RIGHT_MOTOR_ID, IntakeConstants.CAN_BUS));
        
        // Feeder
        canDevices.put("Node_" + FeederConstants.PAN_MOTOR_ID + "_FeederPan", new TalonFX(FeederConstants.PAN_MOTOR_ID, FeederConstants.CAN_BUS));
        canDevices.put("Node_" + FeederConstants.PUSHER_MOTOR_ID + "_FeederPusher", new TalonFX(FeederConstants.PUSHER_MOTOR_ID, FeederConstants.CAN_BUS));
        canDevices.put("Node_" + FeederConstants.FLOOR_ID + "_FeederFloor", new TalonFX(FeederConstants.FLOOR_ID, FeederConstants.CAN_BUS));
    }

    public void startCommandTrace(String commandName) {
        commandStartTimes.put(commandName, Timer.getFPGATimestamp());
        activeTraces.put(commandName, true);
        Logger.recordOutput("PitApp/Alerts/SluggishCommand", "Tracking performance...");
    }

    public void updateDiagnosticsPeriodic() {
        // 1. Command Tracing
        if (activeTraces.getOrDefault("ShootCommand", false)) {
            // Note: Ensure your Shooter.java has a method named isAtTargetRPM()
            boolean systemReady = m_shooter.isAtTargetRPM(); 
            
            if (systemReady) {
                double startTime = commandStartTimes.getOrDefault("ShootCommand", 0.0);
                double timeToSettle = Timer.getFPGATimestamp() - startTime;
                
                Logger.recordOutput("PitApp/CommandTrace/ShootCommand_SettleTimeSec", timeToSettle);
                
                if (timeToSettle > 1.5) {
                    Logger.recordOutput("PitApp/Alerts/SluggishCommand", 
                        "⚠️ Shoot Request took " + String.format("%.2f", timeToSettle) + "s to settle!");
                } else {
                    Logger.recordOutput("PitApp/Alerts/SluggishCommand", "OK: Last shoot request settled in " + String.format("%.2f", timeToSettle) + "s.");
                }
                activeTraces.put("ShootCommand", false);
            }
        }

        // 2. CAN Device Polling
        boolean allNodesHealthy = true;
        for (Map.Entry<String, TalonFX> entry : canDevices.entrySet()) {
            String nodeName = entry.getKey();
            TalonFX motor = entry.getValue();
            
            boolean isConnected = motor.isConnected();
            Logger.recordOutput("PitApp/CAN/" + nodeName, isConnected);
            
            if (!isConnected) {
                allNodesHealthy = false;
                Logger.recordOutput("PitApp/Alerts/CAN_Fault", "CRITICAL: " + nodeName + " is OFFLINE!");
            }
        }

        if (allNodesHealthy) {
            Logger.recordOutput("PitApp/Alerts/CAN_Fault", "OK");
        }
    }
}